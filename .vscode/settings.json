    "cSpell.language": "ca,en",
    "cSpell.words": [
        "batchmean",
        "cmap",
        "Colab",
        "colorbar",
        "cudnn",
        "distilbert",
        "entrenables",
        "facecolor",
        "figsize",
        "Finetuning",
        "fontsize",
        "gaunernst",
        "gelu",
        "hiperparàmetres",
        "IMDB",
        "imshow",
        "ivocab",
        "ivocabulary",
        "Kaggle",
        "LSTM",
        "mapeja",
        "nhead",
        "optimitzador",
        "overfitting",
        "pbar",
        "preds",
        "preentrenades",
        "preentrenat",
        "Preprocessa",
        "PREPROCESSAMENT",
        "reproducibilitat",
        "stanfordnlp",
        "tablefmt",
        "Tokenitza",
        "tokenització",
        "tokenitzades",
        "tokenitzar",
        "tokenitzats",
